{
  "collectionName": "components_molecules_cards",
  "info": {
    "displayName": "card"
  },
  "options": {},
  "attributes": {
    "variant": {
      "type": "enumeration",
      "enum": [
        "full",
        "simple",
        "contact",
        "reference"
      ]
    },
    "icon_variant": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "icon_variant"
            },
            false
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "icon": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "icon_variant"
            },
            true
          ]
        }
      },
      "component": "technical.icon",
      "repeatable": false
    },
    "date": {
      "type": "date",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "full"
          ]
        }
      }
    },
    "subline": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "full"
          ]
        }
      }
    },
    "headline": {
      "type": "string"
    },
    "text": {
      "type": "blocks"
    },
    "cta": {
      "type": "component",
      "component": "molecules.cta",
      "repeatable": false
    }
  },
  "config": {}
}
