        "files",
        "videos",
        "audios"
      ]
    },
    "icon": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "variant"
            },
            "icon"
          ]
        }
      },
      "component": "technical.icon",
      "repeatable": false
    },
    "headline": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "text": {
      "type": "blocks"
    },
    "cta": {
      "type": "component",
      "component": "molecules.cta",
      "repeatable": false
    }
  },
  "config": {}
}
