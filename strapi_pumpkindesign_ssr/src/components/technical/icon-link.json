{
  "collectionName": "components_technical_icon_links",
  "info": {
    "displayName": "icon  link"
  },
  "options": {},
  "attributes": {
    "icon": {
      "type": "component",
      "component": "technical.icon",
      "repeatable": false
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "internal",
        "external"
      ]
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "internal"
          ]
        }
      }
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "external"
          ]
        }
      }
    }
  },
  "config": {}
}
