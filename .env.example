
# Server
HOST=0.0.0.0
PORT=1337

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=
JWT_SECRET=

# Environment
NODE_ENV=production

# Admin
PG_ADMIN_USERNAME=
PG_ADMIN_PASSWORD=

# Angular BFF
BASE_PATH_STRAPI=
STRAPI_API_TOKEN=
STRAPI_API_TOKEN_READ_ONLY=
NG_TRUST_PROXY_HEADERS

# Pumpkin API (Content-Cache)
# Shared secret Strapi sends as X-Webhook-Secret when invalidating the cache.
# Generate with: openssl rand -hex 24
# Required — the service refuses to start without it.
STRAPI_WEBHOOK_SECRET=

# Draft access. Off by default: production must only ever serve published
# content. Set to "true" ONLY in a local environment if you want ?status=draft
# to reach Strapi. Any other value than "true"/"false" refuses to start.
# ALLOW_DRAFT_ACCESS=false

# Optional, defaults in brackets. Times in milliseconds.
# CACHE_TTL_MS=3600000            # fresh window for page/head/foot [1 h]
# CACHE_NAVIGATION_TTL_MS=300000  # shorter, the nav plugin skips webhooks [5 min]
# CACHE_STALE_TTL_MS=86400000     # how long stale content may cover an outage [24 h]
# STRAPI_TIMEOUT_MS=8000
# STRAPI_RETRIES=1